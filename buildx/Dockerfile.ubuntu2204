ARG REPO_URL="https://github.com/Mastercard/p11perftest"
ARG REPO_COMMIT_OR_TAG="HEAD"
ARG REPO_SSLVERIFY="true"
ARG DISTRO_NAME="ubuntu"
ARG DISTRO_VERSION="22.04"
ARG DISTRO_SHORT_NAME="ubuntu2204"
ARG IGNORE_PROXY="false"
ARG SOURCE_MODE="git"
ARG PROXY_ROOT_CA="proxyrootca.crt"
ARG CONFIG_ARGS=""

# Fallback for the "extra-headers" build context: an empty filesystem.
# Overridden when buildx.sh is invoked with --extra-header, to inject a
# vendor-supplied pkcs11.h without polluting the workspace.
FROM scratch AS extra-headers

# base0 is the distribution image with the proxy root CA installed.
# When no root CA is supplied, buildx.sh passes an empty file.
FROM ${DISTRO_NAME}:${DISTRO_VERSION} AS base0
ARG PROXY_ROOT_CA
COPY ${PROXY_ROOT_CA} /usr/local/share/ca-certificates/${PROXY_ROOT_CA}
RUN apt-get update && apt-get install -y ca-certificates && update-ca-certificates && rm -rf /var/lib/apt/lists/*


# Make tools that ship their own trust store (uv, pip, ...) honour the system
# bundle, so that a proxy root CA supplied with --proxyrootca is effective.
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
FROM base0 AS base

# Install required packages for building the project
RUN apt-get update && apt-get install -y \
    build-essential \
    autoconf \
    autoconf-archive \
    automake \
    clang \
    libtool \
    pkg-config \
    gawk \
    git \
    tar \
    gzip \
    dpkg-dev \
    pandoc \
    libboost-dev \
    libboost-program-options-dev \
    libboost-system-dev \
    libssl-dev \
    python3.11 \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/bin/
# Provision the Python used by Botan's configure.py and by pyinstaller. uv
# fetches a standalone build, so the version is the same on every distribution
# and does not depend on what the platform happens to ship.
RUN uv python install 3.13

# Build and install Botan 3 statically.
# No supported distribution ships Botan >= 3.11, which is the first release
# providing the PKCS#11 v3.2 headers required for ML-KEM, ML-DSA and SLH-DSA.
FROM base AS botan
ARG REPO_SSLVERIFY

# Set the git configuration right
RUN if [ "$REPO_SSLVERIFY" != "true" ]; then git config --global http.sslVerify false; fi

WORKDIR /deps/botan
RUN git clone --depth 1 --branch 3.12.0 https://github.com/randombit/botan.git .
# Only the static library is needed: the Botan CLI and test suite pull in
# boost::beast, which does not build against the Boost versions shipped by
# some of the supported distributions, and p11perftest uses neither.
RUN uv run python3 configure.py --cc=gcc \
    --disable-shared-library \
    --build-targets=static \
    --without-documentation \
    && make -j $(nproc) \
    && make install

# Source stage: --local-source mode.
# The build context is the local workspace. We bind-mount it read-only and
# clone from it over the local git protocol: no network access, and only the
# committed history is taken (dirty files are not copied).
FROM botan AS source-local
ARG REPO_COMMIT_OR_TAG
WORKDIR /src
RUN --mount=type=bind,target=/host-repo,ro \
    git -c protocol.file.allow=always clone /host-repo /src \
    && if [ "$REPO_COMMIT_OR_TAG" != "HEAD" ]; then git checkout "$REPO_COMMIT_OR_TAG"; fi

# Source stage: default git-clone mode, cloning REPO_URL from a remote.
FROM botan AS source-git
ARG REPO_URL
ARG REPO_COMMIT_OR_TAG
ARG IGNORE_PROXY
WORKDIR /src
RUN if [ "$IGNORE_PROXY" = "true" ]; then \
        env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY \
            -u all_proxy -u ALL_PROXY -u no_proxy -u NO_PROXY \
            git clone $REPO_URL .; \
    else \
        git clone $REPO_URL .; \
    fi
RUN if [ -d .git ] && [ "$REPO_COMMIT_OR_TAG" != "HEAD" ]; then git checkout $REPO_COMMIT_OR_TAG; fi

# Pick the source variant based on SOURCE_MODE (local|git).
ARG SOURCE_MODE
FROM source-${SOURCE_MODE} AS gitcloned
WORKDIR /src
ENV GIT_CONFIG_COUNT=1
ENV GIT_CONFIG_KEY_0=safe.directory
ENV GIT_CONFIG_VALUE_0=/src

# The meta directory is used to store the version and maintainer information
# for the package built later on
RUN mkdir -p /meta

# Inject any extra cryptoki header (.h) supplied through `--extra-header FILE`
# on the buildx.sh command line. The `extra-headers` build context is
# bind-mounted read-only; when no extra header was passed it falls back to the
# empty `FROM scratch AS extra-headers` stage and this step is a no-op.
# A vendor-supplied pkcs11.h therefore overrides the forwarding header that
# p11perftest ships for Botan.
RUN --mount=type=bind,from=extra-headers,target=/extra-headers,ro \
    find /extra-headers -maxdepth 1 -name '*.h' -exec cp {} src/cryptoki/ \;

# Retrieve information for building DEB package later

# Retrieve the architecture
RUN PKG_ARCH=$(dpkg --print-architecture) \
    && echo "PKG_ARCH=\"$PKG_ARCH\"" >> /meta/env

# Retrieve version information from git
# If the version is a tag, set PKG_GITSUFFIX to the tag, or to '~<commit>' if the tag is not the last commit
RUN PKG_VERSION=$(git describe --tags | sed -E 's/^([^\-]+)(-.*)?$/\1/' ) \
    PKG_RELEASE=$(git describe --tags | sed -E 's/^([^\-]+)(-.*)?$/\2/; s/^-//; s/^$/0/; s/-(.*)//' ) \
    PKG_GITCOMMIT=$(git rev-parse --short HEAD) \
    PKG_GITSUFFIX=$(git describe --tags | sed -E 's/^([^\-]+)(-.*)?$/\2/;s/-([0-9]*)-g(.*)/~\2/') \
    && echo "PKG_GITSUFFIX=\"$PKG_GITSUFFIX\"" >> /meta/env \
    && echo "PKG_VERSION=\"$PKG_VERSION\"" >> /meta/env \
    && echo "PKG_RELEASE=\"$PKG_RELEASE\"" >> /meta/env \
    && echo "PKG_GITCOMMIT=\"$PKG_GITCOMMIT\"" >> /meta/env

# Retrieve the maintainer from git
RUN PKG_MAINTAINER=$(git log -1 --pretty=format:'%an <%ae>') \
    && echo "PKG_MAINTAINER=\"$PKG_MAINTAINER\"" >> /meta/env

# Retrieve description from README.md
# This is a bit more complex as we need to strip out the first heading
# and the first line of the second heading
# moreover, any occurrence of '`' should be removed to avoid issues with
# the shell
RUN PKG_DESCRIPTION=$(cat README.md \
    | awk '/# p11perftest/{flag=1} /# Warning/{flag=0} flag' \
    | sed '/^##.*/d' \
    | pandoc -f markdown -t plain \
    | sed '/^[[:space:]]*$/d' \
    | sed '1!s/^/ /')\
    && echo "PKG_DESCRIPTION=\"$PKG_DESCRIPTION\"" >> /meta/env


RUN echo "export PKG_GITSUFFIX PKG_VERSION PKG_RELEASE PKG_GITCOMMIT PKG_MAINTAINER PKG_ARCH" >> /meta/env


FROM gitcloned AS builder
ARG CONFIG_ARGS

# Build the project for tar package (/usr/local)
RUN ./bootstrap.sh \
    && ./configure $CONFIG_ARGS CXX=g++ CXXFLAGS='-include cstdint'\
    && make -j $(nproc)\
    && make install-strip DESTDIR=/tar_build

# Build the python executables using pyinstaller
RUN uv venv
RUN uv pip install -r requirements.txt \
    && uv run pyinstaller scripts/json2xlsx.spec \
    && uv run pyinstaller scripts/gengraphs.spec \
    && uv run pyinstaller scripts/datapoints2xlsx.spec \
    && install -s -m 755 -t /tar_build/usr/local/bin dist/json2xlsx dist/gengraphs dist/datapoints2xlsx

# Install documentation
RUN mkdir -p /tar_build/usr/local/share/doc/p11perftest \
    && install -m 644 -t /tar_build/usr/local/share/doc/p11perftest README.md CHANGELOG.md COPYRIGHT.md

# Build again the project for deb package (/usr)
RUN make distclean \
    && ./configure $CONFIG_ARGS --prefix=/usr CXX=g++ CXXFLAGS='-include cstdint'  \
    && make -j $(nproc) \
    && make install-strip DESTDIR=/deb_build

# Build the python executables using pyinstaller
RUN install -s -m 755 -t /deb_build/usr/bin dist/json2xlsx dist/gengraphs dist/datapoints2xlsx

# Install documentation
RUN mkdir -p /deb_build/usr/share/doc/p11perftest \
    && install -m 644 -t /deb_build/usr/share/doc/p11perftest README.md CHANGELOG.md COPYRIGHT.md


# Final stage
FROM builder AS final
ARG DISTRO_SHORT_NAME
# REPO_URL is referenced by the package metadata generated below.
# ARG values do not cross build stages, so it must be redeclared here.
ARG REPO_URL

RUN mkdir -p /artifacts

# build the .tar.gz file
WORKDIR /tar_build
RUN . /meta/env && tar -czf /artifacts/p11perftest-${DISTRO_SHORT_NAME}-${PKG_ARCH}-${PKG_VERSION}${PKG_GITSUFFIX}.tar.gz usr

# build the deb package
WORKDIR /deb_build
RUN mkdir -p DEBIAN /artifacts

# Create control file for the package
RUN . /meta/env \
    && echo "Package: p11perftest" > DEBIAN/control \
    && echo "Homepage: $REPO_URL" >> DEBIAN/control \
    && echo "License: Apache-2.0" >> DEBIAN/control \
    && echo "Version: $PKG_VERSION$PKG_GITSUFFIX" >> DEBIAN/control \
    && echo "X-Vcs-Git: $REPO_URL" >> DEBIAN/control \
    && echo "X-Git-Commit: $PKG_GITCOMMIT" >> DEBIAN/control \
    && echo "Section: misc" >> DEBIAN/control \
    && echo "Priority: optional" >> DEBIAN/control \
    && echo "Architecture: $PKG_ARCH" >> DEBIAN/control \
    && echo "Depends: libc6,libboost-program-options1.74.0" >> DEBIAN/control \
    && echo "Maintainer: $PKG_MAINTAINER" >> DEBIAN/control \
    && echo "Description: A utility for testing PKCS#11 implementations" >> DEBIAN/control


RUN  cat /meta/env && echo "cache-buster-$(date +%s)"

# Build the .deb package
RUN . /meta/env \
    && dpkg-deb --build /deb_build /artifacts/p11perftest-${DISTRO_SHORT_NAME}-${PKG_ARCH}-${PKG_VERSION}${PKG_GITSUFFIX}.deb
#
# Final command to list the artifacts
CMD [ "find", "/artifacts", "-type", "f" ]

